# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server Configuration
BASE_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# CRM Integration (Optional)
# Webhook URL for sending lead data to your CRM
LEAD_WEBHOOK_URL=https://your-crm.com/api/leads

# Rate Limiting
# Max requests per IP per hour for /analyze endpoint
ANALYZE_RATE_LIMIT=5

# Max requests per IP per hour for /render endpoint
RENDER_RATE_LIMIT=3

# CORS Configuration (Optional)
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Image Storage (Optional)
# Path where generated renders will be stored
# STATIC_DIR=./backend/static

# Logging (Optional)
# LOG_LEVEL=INFO
